    "build": "node build.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
}
